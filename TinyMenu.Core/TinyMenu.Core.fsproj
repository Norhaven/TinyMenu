<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Engine\Configuration.fs" />
    <Compile Include="Engine\Platforms.fs" />
    <Compile Include="Engine\Prompts.fs" />
    <Compile Include="Engine\ConfigurationManager.fs" />
    <Compile Include="Engine\CommandInterpolation.fs" />
    <Compile Include="Engine\CommandBuilders.fs" />
    <Compile Include="CLI.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

</Project>
